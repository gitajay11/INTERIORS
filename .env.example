# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Neon). Without it, submissions are written to .data/*.json in development.
DATABASE_URL=

# Sanity CMS. Without it, the site serves the bundled demo content in lib/data.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Resend. Without it, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Interiors <studio@example.com>"
STUDIO_NOTIFICATION_EMAIL=studio@example.com

# Google Maps Embed API key (the contact page falls back to a keyless embed)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# WhatsApp number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=914445678900

# Cloudflare Turnstile. Without both keys the widget and server check are skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
